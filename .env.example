# Claude API key — questions, follow-ups and feedback. Without it the built-in offline engine is used.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Azure AI Speech — natural Uzbek interviewer voice (uz-UZ-MadinaNeural / uz-UZ-SardorNeural).
# Free tier F0 gives 0.5M characters/month. Without it, the browser's own voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Where accounts and interviews are stored (default: ./data/db.json)
# DATA_FILE=./data/db.json

# UzbekVoice.ai — Uzbek speech-to-text (enhanced-stt) and text-to-speech. Preferred for Uzbek over Azure/browser.
UZBEKVOICE_API_KEY=

# Users can connect their own AI provider (Gemini, Groq, OpenRouter, OpenAI, Claude, DeepSeek, Mistral,
# or any OpenAI-compatible server) in Settings. Their API keys are AES-256-GCM encrypted with this secret.
# If unset, a random secret is generated once in data/.secret.
# APP_SECRET=
